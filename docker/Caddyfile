:80 {
	root * /app/dist/client
	
	# Enable compression
	encode zstd gzip

	# Serve static files if they exist
	file_server

	# Proxy dynamic requests to the Astro Node server (Hybrid mode)
	@not_static {
		not file
	}
	reverse_proxy @not_static localhost:4321

	# Cache Astro static assets (hashed filenames)
	@static {
		path /_astro/*
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Cache fonts and static images in /public
	@static_public {
		path /fonts/* /icons/* /favicon.webp
	}
	header @static_public Cache-Control "public, max-age=31536000, immutable"

	# Basic security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
	}
}
