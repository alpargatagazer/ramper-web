:80 {
	root * /app/dist/client
	
	# Enable compression
	encode zstd gzip

	# 1. ALWAYS proxy Keystatic and API to the Node server
	# We do this first to ensure static placeholders in dist/ don't shadow the admin UI
	reverse_proxy /keystatic* /api/* localhost:4321

	# 2. Serve static files if they exist for other paths
	file_server

	# 3. Fallback for SPA/SSR routes (if not a static file and not already proxied)
	@not_static {
		not path /keystatic* /api/*
		not file
	}
	reverse_proxy @not_static localhost:4321

	# Cache Astro static assets (hashed filenames)
	@static {
		path /_astro/*
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Cache fonts and static images in /public
	@static_public {
		path /fonts/* /icons/* /favicon.webp
	}
	header @static_public Cache-Control "public, max-age=31536000, immutable"

	# Basic security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
	}
}
