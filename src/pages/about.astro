---
// src/pages/about.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import BandCarousel from '@/components/BandCarousel.astro';
import { getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import EmptyState from '@/components/EmptyState.astro';

import bandPhoto from '@/assets/band/1.webp';

const aboutEntry = await getEntry('about', 'index');
const { Content } = aboutEntry ? await render(aboutEntry) : { Content: null };

const ogImg = await getImage({ src: bandPhoto, width: 1200, height: 630, format: 'jpg', quality: 85 });
---

<BaseLayout title="Ramper | ¿...quién?" description="El grupo" activeSection="about" ogImage={ogImg.src}>
  <div class="flex flex-col h-full overflow-y-auto" id="about-content">
    {/* Band photos carousel */}
    <div class="flex-shrink-0">
      <BandCarousel />
    </div>

    {/* Bio text — below the photo */}
    <div class="w-full px-4 md:px-6 py-5 bg-ramper-white/18 backdrop-blur-[2px]" id="about-bio">
      <div class="prose-ramper text-ramper-black max-w-none">
        {Content ? <Content /> : <EmptyState message="Falta la biografía del grupo. Por favor, añádela en el CMS." icon="📝" />}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  #about-bio :global(p) {
    font-size: 0.8125rem;
    line-height: 1.25;
    letter-spacing: -0.03em;
    margin-top: 0.35rem;
    margin-bottom: 0.35rem;
  }
  @media (min-width: 768px) {
    #about-bio :global(p) {
      font-size: 1.1rem;
      line-height: 1.25;
      letter-spacing: -0.035em;
    }
  }
</style>

