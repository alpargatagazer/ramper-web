---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import hand1 from '../assets/hands/hand-1.webp';
import hand2 from '../assets/hands/hand-2.webp';
import hand3 from '../assets/hands/hand-3.webp';
import hand4 from '../assets/hands/hand-4.webp';
---

<BaseLayout>
  {/* Asymmetric hand art grid - matching the Figma layout */}
  <div class="flex flex-col justify-start md:justify-center items-center p-8 md:p-12 pt-16 md:pt-12 gap-8 md:h-full" id="index-grid">
    {/* Top row: large hand-1 (fist) + medium hand-2 (drooping) */}
    <div class="flex gap-[4vw] md:gap-12 items-start translate-x-[-2vw] md:translate-x-[-40px] w-full max-w-[800px] justify-center">
      <Image
        src={hand1}
        alt="Hand illustration — fist"
        class="w-[45%] max-w-[360px] h-auto object-contain"
        width={360}
        loading="eager"
      />
      <Image
        src={hand2}
        alt="Hand illustration — drooping hand"
        class="w-[40%] max-w-[320px] h-auto object-contain mt-[5%]"
        width={320}
        loading="eager"
      />
    </div>
    {/* Bottom row: large hand-3 (bird/flying) + small hand-4 (thumbs) */}
    <div class="flex gap-[5vw] md:gap-16 items-start translate-x-[2vw] md:translate-x-[40px] w-full max-w-[800px] justify-center">
      <Image
        src={hand3}
        alt="Hand illustration — flying hand"
        class="w-[50%] max-w-[380px] h-auto object-contain"
        width={380}
      />
      <Image
        src={hand4}
        alt="Hand illustration — pointing hand"
        class="w-[30%] max-w-[220px] h-auto object-contain mt-[3%]"
        width={220}
      />
    </div>
  </div>
</BaseLayout>

