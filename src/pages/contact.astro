---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import humoLogo from '../assets/logo-humo.webp';

const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || 'pablo@humointernacional.com';
const formEmail = import.meta.env.PUBLIC_FORM_EMAIL || contactEmail;
---

<BaseLayout title="Ramper | escribe" activeSection="contact">
  <div class="page-container pt-section-top mt-[-25px] w-full max-w-6xl" id="contact-page">
    <div class="w-full">

      {/* Header */}
      <h1 class="text-3xl text-ramper-black mb-5" id="contact-heading">
        pasa a decir hola:
      </h1>

      {/* Two-column layout: Form + Info */}
      <div class="content-overlay p-6 md:p-10 flex flex-col md:flex-row gap-12 md:gap-24 w-full">

        {/* LEFT: Contact Form */}
        <div class="flex-1 max-w-md" id="contact-form-section">
          <form id="contact-form" class="space-y-6">
            {/* Name + Email side by side */}
            <div class="flex flex-col md:flex-row gap-8">
              <div class="flex-1">
                <label for="contact-name" class="block text-sm font-bold text-ramper-black mb-2 uppercase tracking-wider">
                  Nombre:
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  class="w-full bg-transparent border-b border-ramper-black/30 focus:border-ramper-blue-deep focus:outline-none py-2 text-ramper-black placeholder:text-ramper-black/30 transition-colors"
                />
              </div>
              <div class="flex-1">
                <label for="contact-email" class="block text-sm font-bold text-ramper-black mb-2 uppercase tracking-wider">
                  Email:
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  class="w-full bg-transparent border-b border-ramper-black/30 focus:border-ramper-blue-deep focus:outline-none py-2 text-ramper-black placeholder:text-ramper-black/30 transition-colors"
                />
              </div>
            </div>

            {/* Message */}
            <div>
              <label for="contact-message" class="block text-sm font-bold text-ramper-black mb-2 uppercase tracking-wider">
                Mensaje:
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                class="w-full bg-transparent border border-ramper-black/30 focus:border-ramper-blue-deep focus:outline-none p-3 text-ramper-black placeholder:text-ramper-black/30 transition-colors resize-none"
              ></textarea>
            </div>

            {/* Submit button */}
            <button
              type="submit"
              id="contact-submit"
              class="btn-primary cursor-pointer"
              data-form-email={formEmail}
            >
              enviar mensaje
            </button>
          </form>
        </div>

        {/* RIGHT: Contact Information */}
        <div class="flex-shrink-0 md:min-w-[280px]" id="contact-info-section">
          <h2 class="text-lg font-bold text-ramper-black mb-4">
            Management & Bookings:
          </h2>

          <div class="flex items-center gap-2 mb-10">
            <span class="text-ramper-black text-xs">■</span>
            <button
              id="copy-email-btn"
              class="text-ramper-blue-deep font-bold hover:text-ramper-blue-mid transition-colors cursor-pointer underline underline-offset-4 decoration-ramper-blue-deep/30 hover:decoration-ramper-blue-mid/50 bg-transparent border-none p-0 text-left break-all"
              data-email={contactEmail}
            >
              {contactEmail}
            </button>
          </div>

          <p id="copy-feedback" class="text-sm text-ramper-black/50 mt-[-32px] mb-6 h-5 transition-opacity opacity-0">
            {/* Feedback text appears here */}
          </p>

          {/* Humo Internacional logo */}
          <a
            href="https://humointernacional.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block hover:opacity-80 transition-opacity"
            id="humo-logo-link"
          >
            <Image
              src={humoLogo}
              alt="Humo Internacional"
              class="w-[250px] mt-[-30px] md:w-[225px] h-auto"
              width={300}
            />
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    // --- Web3Forms Logic ---
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
    
    // Create a feedback message element for the form
    const formFeedback = document.createElement('p');
    formFeedback.className = 'text-sm mt-4 font-bold transition-opacity duration-300 opacity-0';
    if (form) form.appendChild(formFeedback);

    if (form && submitBtn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Visual feedback during submission
        const originalText = submitBtn.textContent;
        submitBtn.textContent = 'Enviando...';
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-50');
        
        const formData = new FormData(form);
        // Web3Forms access key from environment variable
        const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
        formData.append('access_key', accessKey);
        
        try {
          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: formData
          });
          
          const data = await response.json();
          
          if (data.success) {
            formFeedback.textContent = 'Mensaje enviado correctamente. ¡Gracias!';
            formFeedback.classList.remove('text-red-500');
            formFeedback.classList.add('text-ramper-blue-deep', 'opacity-100');
            form.reset();
          } else {
            throw new Error(data.message || 'Error al enviar');
          }
        } catch (error) {
          formFeedback.textContent = 'Hubo un error al enviar. Por favor, intenta de nuevo o copia el email.';
          formFeedback.classList.remove('text-ramper-blue-deep');
          formFeedback.classList.add('text-red-500', 'opacity-100');
        } finally {
          // Restore button
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
          submitBtn.classList.remove('opacity-50');
          
          // Hide feedback after 5 seconds
          setTimeout(() => {
            formFeedback.classList.remove('opacity-100');
          }, 5000);
        }
      });
    }

    // --- Copy Email Logic ---
    const btn = document.getElementById('copy-email-btn');
    const feedback = document.getElementById('copy-feedback');

    if (btn && feedback) {
      btn.addEventListener('click', async () => {
        const email = btn.getAttribute('data-email');
        if (email) {
          try {
            await navigator.clipboard.writeText(email);
            feedback.textContent = 'Copiado al portapapeles';
            feedback.classList.remove('opacity-0');
            feedback.classList.add('opacity-100');
            setTimeout(() => {
              feedback.classList.remove('opacity-100');
              feedback.classList.add('opacity-0');
              setTimeout(() => { feedback.textContent = ''; }, 300);
            }, 2000);
          } catch {
            // Fallback: open mailto
            window.location.href = `mailto:${email}`;
          }
        }
      });
    }
  });
</script>
