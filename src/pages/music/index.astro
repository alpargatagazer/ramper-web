---
// src/pages/music/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import { typeLabels } from '../../constants';

const releases = await getCollection('releases');
// Sort chronologically for mobile fallback
releases.sort((a, b) => new Date(b.data.releaseDate).valueOf() - new Date(a.data.releaseDate).valueOf());

// Map precise desktop layout sizes and positions
const layoutStyles: Record<string, string> = {
  '1-el-hoyo': 'md:absolute md:w-[19%] md:left-[8%] md:top-[-3%]',
  '2-nuestros-mejores-deseos': 'md:absolute md:w-[32%] md:left-[35%] md:top-[-12%]',
  '3-sesiones-bravas': 'md:absolute md:w-[19%] md:left-[72.5%] md:top-[10%]',
  '4-solo-postres': 'md:absolute md:w-[32%] md:left-[7%] md:top-[39.5%]',
  '5-el-tamborilero': 'md:absolute md:w-[16%] md:left-[46%] md:top-[40.75%]',
  '6-la-caja-del-diablo': 'md:absolute md:w-[16%] md:left-[52%] md:top-[74.25%]',
  '7-solo-postres-en-teatros-del-canal': 'md:absolute md:w-[25%] md:left-[75%] md:top-[42.5%]'
};


---

<BaseLayout title="Ramper | música" activeSection="music">
  <div class="h-full overflow-y-auto overflow-x-hidden p-8 pt-section-top md:pt-[200px] max-w-[1000px] mx-auto" id="music-grid">

    <div class="flex flex-col gap-8 md:gap-16 items-center md:block md:relative md:w-full md:aspect-[1000/800]">
      {releases.map((release, index) => {
        const year = new Date(release.data.releaseDate).getFullYear();
        const typeLabel = typeLabels[release.data.type];
        const desktopStyles = layoutStyles[release.id] || 'md:relative md:w-[200px]';

        return (
          <a
            href={`/music/${release.id}`}
            class:list={[
              'block group transition-transform duration-300 hover:scale-[1.02] hover:z-50 relative z-10',
              'w-[80%] max-w-[400px]', // Mobile default width
              desktopStyles
            ]}
            id={`release-${release.id}`}
          >
            {release.data.coverImage ? (
              <Picture
                src={release.data.coverImage}
                alt={`Portada de ${release.data.title}`}
                class="w-full h-auto object-cover aspect-square noise-overlay shadow-sm"
                widths={[200, 400, 800]}
                sizes="(min-width: 1024px) 400px, 80vw"
                loading={index < 2 ? "eager" : "lazy"}
                fetchpriority={index < 2 ? "high" : "auto"}
                formats={['avif', 'webp']}
                quality={40}
                transition:name={`release-cover-${release.id}`}
              />
            ) : (
              <div class="w-full aspect-square bg-ramper-black/10 flex items-center justify-center text-xs text-ramper-black/40 uppercase tracking-widest shadow-sm">
                Cover
              </div>
            )}
            <div class="text-center mt-2 w-full">
              <p class="font-bold text-ramper-black text-[13px] leading-tight">
                {release.data.title} ({year})
              </p>
              {typeLabel && (
                <p class="text-[11px] text-ramper-black/60 mt-1">
                  [{typeLabel}]
                </p>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
