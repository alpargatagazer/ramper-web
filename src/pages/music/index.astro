---
// src/pages/music/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ReleaseCard from '@/components/ReleaseCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import { typeLabels } from '@/constants';
import { formatYear } from '@/utils/dates';

const releases = await getCollection('releases');
// Sort chronologically for mobile fallback
releases.sort((a, b) => new Date(b.data.releaseDate).valueOf() - new Date(a.data.releaseDate).valueOf());

// Map precise desktop layout sizes and positions
const layoutStyles: Record<string, string> = {
  '1-el-hoyo': 'md:absolute md:w-[19%] md:left-[8%] md:top-[-3%]',
  '2-nuestros-mejores-deseos': 'md:absolute md:w-[32%] md:left-[35%] md:top-[-12%]',
  '3-sesiones-bravas': 'md:absolute md:w-[19%] md:left-[75%] md:top-[8%]',
  '4-solo-postres': 'md:absolute md:w-[32%] md:left-[6%] md:top-[36%]',
  '5-el-tamborilero': 'md:absolute md:w-[16%] md:left-[46%] md:top-[40.75%]',
  '6-la-caja-del-diablo': 'md:absolute md:w-[16%] md:left-[72%] md:top-[49%]',
  '7-solo-postres-en-teatros-del-canal': 'md:absolute md:w-[25%] md:left-[20%] md:top-[90%]',
  '8-dos-criaturas': 'md:absolute md:w-[32%] md:left-[56%] md:top-[85%]'
};
---

<BaseLayout title="Ramper | música" activeSection="music">
  <div class="h-full overflow-y-auto overflow-x-hidden p-14 pt-section-top md:pt-[140px] max-w-[1000px] mx-auto" id="music-grid">

    {releases.length === 0 ? (
      <EmptyState message="No hay material publicado todavía." icon="💿" />
    ) : (
      <>
        <div class="flex flex-col gap-8 md:gap-16 items-center md:block md:relative md:w-full md:aspect-[1000/800] md:mb-40">
          {releases.map((release, index) => {
            const desktopStyles = layoutStyles[release.id] || 'md:relative md:w-[50px]';

            return (
              <ReleaseCard
                id={release.id}
                title={release.data.title}
                year={formatYear(release.data.releaseDate)}
                typeLabel={typeLabels[release.data.type]}
                coverImage={release.data.coverImage}
                className={`w-[80%] max-w-[400px] ${desktopStyles}`}
                href={`/music/${release.id}`}
                eagerLoad={index < 2}
              />
            );
          })}
        </div>
      </>
    )}
  </div>
</BaseLayout>
