---
import { getImage } from 'astro:assets';
import faviconAsset from '@/assets/og-base.webp';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  siteUrl: string;
  canonicalUrl: string;
}

const {
  title = 'Ramper',
  description = 'Helpless children',
  siteUrl,
  canonicalUrl,
} = Astro.props;

const optimizedOgImage = await getImage({
  src: faviconAsset,
  width: 1200,
  height: 600,
  format: 'webp',
  fit: 'cover',
  position: 'top'
});

const ogImage = Astro.props.ogImage ?? optimizedOgImage.src;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="preload" href="/fonts/host-grotesk/host-grotesk-normal.woff2" as="font" type="font/woff2" crossorigin />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/webp" href="/favicon.webp" />
<link rel="canonical" href={canonicalUrl} />

{/* Open Graph */}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage, siteUrl)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="600" />
<meta property="og:image:type" content="image/webp" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content="es_ES" />

{/* Twitter Card */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(ogImage, siteUrl)} />

{/* JSON-LD Structured Data */}
<script type="application/ld+json" is:inline>
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MusicGroup",
    "name": "Ramper",
    "url": siteUrl,
    "description": description,
    "genre": ["Slowcore", "Post-rock"],
    "nationality": "Spanish",
  })}
</script>
