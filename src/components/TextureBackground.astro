---
// src/components/TextureBackground.astro
// Active album: "Dos criaturas" (feathers + hair continuous digital dissolve, stars & red scribble).
// Previous album: "Solo postres" (dirt, stars, red scribble).
import { Picture } from 'astro:assets';

// "Dos criaturas" textures
import feathersTexture from '../assets/textures/feathers.webp';
import hairTexture from '../assets/textures/hair.webp';

// Shared / "Solo postres" textures
import redTexture from '../assets/textures/red.webp';
import dirtyTexture from '../assets/textures/dirty.webp';
import starsTexture from '../assets/textures/stars.webp';
---

{/* ═══════ "DOS CRIATURAS" BACKGROUND (active default) ═══════ */}
<div class="texture-bg texture-bg--dos-criaturas absolute inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
  {/* Layer 1A: Feathers (pigeon) - scaled to crop blank borders */}
  <div class="texture-layer texture-layer--feathers absolute inset-0 overflow-hidden">
    <div id="feathers-canvas" class="w-full h-full scale-125 origin-center">
      <Picture
        src={feathersTexture}
        alt=""
        class="w-full h-full object-cover"
        widths={[640, 1200, 1920]}
        sizes="100vw"
        loading="eager"
        quality={70}
        formats={['avif', 'webp']}
      />
    </div>
  </div>

  {/* Layer 1B: Hair (cat) - scaled to crop blank borders */}
  <div class="texture-layer texture-layer--hair absolute inset-0 overflow-hidden">
    <div id="hair-canvas" class="w-full h-full scale-125 origin-center">
      <Picture
        src={hairTexture}
        alt=""
        class="w-full h-full object-cover"
        widths={[640, 1200, 1920]}
        sizes="100vw"
        loading="eager"
        quality={70}
        formats={['avif', 'webp']}
      />
    </div>
  </div>

  {/* Layer 2: Red scribble */}
  <Picture
    src={redTexture}
    alt=""
    class="absolute inset-0 h-full w-auto object-contain top-100 opacity-50 scale-[2.2] -translate-x-[150px] origin-left"
    widths={[640, 1200]}
    sizes="(min-width: 1024px) 1200px, 100vw"
    fetchpriority="high"
    loading="eager"
    decoding="sync"
    quality={60}
    formats={['avif', 'webp']}
  />
</div>

{/* ═══════ "SOLO POSTRES" BACKGROUND ═══════ */}
<div class="texture-bg texture-bg--solo-postres absolute inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
  {/* Layer 1: Paper/dirt texture */}
  <Picture
    src={dirtyTexture}
    alt=""
    class="absolute inset-0 w-full h-full object-cover opacity-50"
    widths={[640, 1200, 1920]}
    sizes="100vw"
    loading="eager"
    quality={60}
    formats={['avif', 'webp']}
  />
  {/* Layer 2: Hand-drawn stars */}
  <Picture
    src={starsTexture}
    alt=""
    class="absolute inset-0 w-full h-full object-cover opacity-80"
    widths={[640, 1200, 1920]}
    sizes="100vw"
    loading="eager"
    quality={60}
    formats={['avif', 'webp']}
  />
  {/* Layer 3: Red scribble */}
  <Picture
    src={redTexture}
    alt=""
    class="absolute inset-0 h-full w-auto object-contain top-100 opacity-50 scale-[2.2] -translate-x-[150px] origin-left"
    widths={[640, 1200]}
    sizes="(min-width: 1024px) 1200px, 100vw"
    fetchpriority="high"
    loading="eager"
    decoding="sync"
    quality={60}
    formats={['avif', 'webp']}
  />
</div>

<style>
  /* ── Theme visibility ── */
  .texture-bg--solo-postres   { display: none; }
  .texture-bg--dos-criaturas  { display: block; }

  :global(html[data-theme="solo-postres"]) .texture-bg--solo-postres   { display: block; }
  :global(html[data-theme="solo-postres"]) .texture-bg--dos-criaturas  { display: none; }

  /* ── Continuous digital crossfade animation ──
     Constant slow dissolve back and forth using steps for digital quantization.
     Lower opacity for subtle transparent blend. */
  .texture-layer--feathers {
    animation: digital-dissolve-a 5s steps(100) infinite alternate;
  }

  .texture-layer--hair {
    animation: digital-dissolve-b 5s steps(100) infinite alternate;
  }

  @keyframes digital-dissolve-a {
    0% {
      opacity: 0.35;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes digital-dissolve-b {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .texture-layer--feathers {
      animation: none;
      opacity: 0.2;
    }
    .texture-layer--hair {
      animation: none;
      opacity: 0.2;
    }
  }
</style>

<script is:inline>
  (function initTextureRandomizer() {
    function setup() {
      const feathersLayer = document.querySelector('.texture-layer--feathers');
      const hairLayer = document.querySelector('.texture-layer--hair');
      const feathersCanvas = document.querySelector('#feathers-canvas');
      const hairCanvas = document.querySelector('#hair-canvas');

      if (!feathersLayer || !hairLayer || !feathersCanvas || !hairCanvas) return;
      if (feathersLayer.dataset.randomizerInit === 'true') return;
      feathersLayer.dataset.randomizerInit = 'true';

      function getRandomOffset() {
        // Discrete small offsets close to origin (e.g. 5,2 / -4,1 / 4,-3 / -1,3)
        const x = (Math.random() * 10 - 10).toFixed(1);
        const y = (Math.random() * 8 - 8).toFixed(1);
        return { x, y };
      }

      let feathersCount = 0;
      feathersLayer.addEventListener('animationiteration', () => {
        feathersCount++;
        // Odd iteration (1, 3, 5...) is when feathers reaches opacity 0 (invisible)
        if (feathersCount % 2 === 1) {
          const { x, y } = getRandomOffset();
          feathersCanvas.style.transform = `scale(1.25) translate(${x}%, ${y}%)`;
        }
      });

      let hairCount = 0;
      hairLayer.addEventListener('animationiteration', () => {
        hairCount++;
        // Even iteration (2, 4, 6...) is when hair reaches opacity 0 (invisible)
        if (hairCount % 2 === 0) {
          const { x, y } = getRandomOffset();
          hairCanvas.style.transform = `scale(1.25) translate(${x}%, ${y}%)`;
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
    document.addEventListener('astro:page-load', setup);
  })();
</script>
