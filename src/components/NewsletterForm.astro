---
// src/components/NewsletterForm.astro
---

<div class="p-6 mb-8 max-w-md mx-auto" id="newsletter-container">
  <div class="w-full">
    <p class="text-xs text-ramper-black/70 mb-2">
      Recibe cada nueva publicación directamente en tu correo.
    </p>

    <form 
      id="newsletter-form" 
      class="flex flex-col sm:flex-row gap-2"
    >
      <div class="flex-1 relative">
        <label for="newsletter-email" class="sr-only">Correo electrónico</label>
        <input 
          type="email" 
          id="newsletter-email" 
          name="email" 
          placeholder="tu@correo.com" 
          required 
          class="w-full bg-ramper-white/50 border border-ramper-black/20 text-ramper-black px-3 py-2 text-sm focus:outline-none focus:border-ramper-blue-deep focus:ring-1 focus:ring-ramper-blue-deep transition-colors placeholder:text-ramper-black/40"
        />
      </div>
      <button 
        type="submit" 
        id="newsletter-submit"
        class="bg-ramper-blue-deep text-ramper-white px-4 py-2 text-xs font-bold uppercase tracking-wider hover:bg-ramper-blue-mid transition-colors flex items-center justify-center min-w-[110px]"
      >
        <span>Suscribirse</span>
      </button>
    </form>

    <div id="newsletter-message" class="hidden mt-3 text-xs font-medium p-2"></div>
  </div>
</div>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const emailInput = document.getElementById('newsletter-email') as HTMLInputElement;
  const submitBtn = document.getElementById('newsletter-submit') as HTMLButtonElement;
  const messageDiv = document.getElementById('newsletter-message') as HTMLDivElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const email = emailInput.value;
      // Reset states
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
      submitBtn.innerHTML = '<span>Enviando...</span>';
      messageDiv.classList.add('hidden');
      messageDiv.classList.remove('bg-green-50', 'text-green-800', 'bg-red-50', 'text-red-800');

      try {
        const response = await fetch(`/api/newsletter/subscribe`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            email: email,
            list_uuids: [import.meta.env.PUBLIC_NEWSLETTER_LIST_UUID || '']
          }),
        });

        if (response.ok) {
          showSuccess('¡Gracias por suscribirte! Revisa tu bandeja para confirmar.');
          resetForm();
        } else {
          throw new Error('Error en el servidor');
        }
      } catch (error) {
        messageDiv.textContent = 'Hubo un error al procesar tu solicitud. Inténtalo de nuevo.';
        messageDiv.classList.add('bg-red-50', 'text-red-800', 'block');
        messageDiv.classList.remove('hidden');
        
        // Reset button
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
        submitBtn.innerHTML = '<span>Suscribirse</span>';
      }
    });
  }

  function showSuccess(msg: string) {
    messageDiv.textContent = msg;
    messageDiv.classList.add('bg-green-50', 'text-green-800', 'block');
    messageDiv.classList.remove('hidden');
  }

  function resetForm() {
    emailInput.value = '';
    submitBtn.disabled = false;
    submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
    submitBtn.innerHTML = '<span>Suscrito ✓</span>';
    setTimeout(() => {
      submitBtn.innerHTML = '<span>Suscribirse</span>';
    }, 3000);
  }
</script>
