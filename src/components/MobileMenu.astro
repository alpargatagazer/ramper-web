---
import SocialLinks from '@/components/SocialLinks.astro';

interface NavItem {
  label: string;
  href: string;
  section: string;
  external?: boolean;
}

interface Props {
  navItems: NavItem[];
  secondaryNavItems: NavItem[];
  tertiaryNavItems: NavItem[];
  activeSection?: string;
  instagramUrl?: string;
  xUrl?: string;
  blueskyUrl?: string;
}

const {
  navItems,
  secondaryNavItems,
  tertiaryNavItems,
  activeSection = '',
  instagramUrl = '',
  xUrl = '',
  blueskyUrl = '',
} = Astro.props;

const externalArrowSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="inline-block w-6 h-6 ml-1 mb-[3px]"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>`;
---

<div
  id="mobile-menu-overlay"
  class="absolute inset-0 z-40 bg-ramper-white opacity-0 pointer-events-none invisible transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
>
  <nav class="flex flex-col items-end pr-8 md:pr-16 pt-[160px] md:pt-[190px] h-full overflow-y-auto">
    <ul class="list-none space-y-6 md:space-y-8 text-[36px] md:text-[54px] leading-[1.2] font-normal text-right">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'block transition-colors hover:text-ramper-blue-mid mobile-nav-link nav-link-interactive',
              activeSection === item.section
                ? 'font-bold text-ramper-blue-deep'
                : 'text-ramper-black'
            ]}
            {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            {...(activeSection === item.section && !item.external ? { 'aria-current': 'page' } : {})}
          >
            {item.label.replace('↗', '')}
            {item.label.includes('↗') && (
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="inline-block w-6 h-6 md:w-9 md:h-9 ml-1 mb-[3px] md:mb-[5px]">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            )}
          </a>
        </li>
      ))}

      {/* About section */}
      <li class="mt-10 md:mt-14">
        {secondaryNavItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'block transition-colors hover:text-ramper-blue-mid mobile-nav-link',
              activeSection === item.section
                ? 'font-bold text-ramper-blue-deep'
                : 'text-ramper-black'
            ]}
            {...(activeSection === item.section ? { 'aria-current': 'page' } : {})}
          >
            {item.label}
          </a>
        ))}
      </li>

      {/* Contact section */}
      <li class="mt-10 md:mt-14">
        {tertiaryNavItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'block transition-colors hover:text-ramper-blue-mid mobile-nav-link',
              activeSection === item.section
                ? 'font-bold text-ramper-blue-deep'
                : 'text-ramper-black'
            ]}
            {...(activeSection === item.section ? { 'aria-current': 'page' } : {})}
          >
            {item.label}
          </a>
        ))}
      </li>

      {/* Social links */}
      {(instagramUrl || xUrl || blueskyUrl) && (
        <li class="mt-10 md:mt-14 flex justify-end">
          <SocialLinks
            instagramUrl={instagramUrl}
            xUrl={xUrl}
            blueskyUrl={blueskyUrl}
            gap="gap-5 md:gap-7"
            iconSize="w-[28px] h-[28px] md:w-[38px] md:h-[38px]"
          />
        </li>
      )}
    </ul>
  </nav>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggle = document.getElementById('mobile-menu-toggle');
    const overlay = document.getElementById('mobile-menu-overlay');
    const hamburger = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!toggle || !overlay || !hamburger || !closeIcon) return;

    function openMenu() {
      overlay!.classList.remove('opacity-0', 'pointer-events-none', 'invisible');
      overlay!.classList.add('opacity-100');
      overlay!.setAttribute('aria-hidden', 'false');
      hamburger!.classList.add('hidden');
      closeIcon!.classList.remove('hidden');
      toggle!.setAttribute('aria-expanded', 'true');
      toggle!.setAttribute('aria-label', 'Cerrar menú');
    }

    function closeMenu() {
      overlay!.classList.add('opacity-0', 'pointer-events-none', 'invisible');
      overlay!.classList.remove('opacity-100');
      overlay!.setAttribute('aria-hidden', 'true');
      hamburger!.classList.remove('hidden');
      closeIcon!.classList.add('hidden');
      toggle!.setAttribute('aria-expanded', 'false');
      toggle!.setAttribute('aria-label', 'Abrir menú');
    }

    toggle.onclick = () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    };

    overlay.onclick = (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        closeMenu();
      }
    };

    closeMenu();
  });
</script>
