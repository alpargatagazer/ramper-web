---
// src/layouts/BaseLayout.astro
import { ClientRouter } from 'astro:transitions';

import Head from '@/components/Head.astro';
import TextureBackground from '@/components/TextureBackground.astro';
import MobileHeader from '@/components/MobileHeader.astro';
import MobileMenu from '@/components/MobileMenu.astro';
import DesktopSidebar from '@/components/DesktopSidebar.astro';
import SocialLinks from '@/components/SocialLinks.astro';

import '../styles/global.css';
import '../styles/fonts.css';

interface Props {
  title?: string;
  description?: string;
  activeSection?: string;
  ogImage?: string;
}

const {
  title = 'Ramper',
  description = 'Helpless children',
  activeSection = '',
  ogImage,
} = Astro.props;

// Canonical URL for SEO
const siteUrl = import.meta.env.DEV ? Astro.url.origin : (Astro.site ? new URL(Astro.site).origin : Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

// Social media URLs from environment variables
const instagramUrl = import.meta.env.PUBLIC_INSTAGRAM_URL || 'https://www.instagram.com/ramper.dep/';
const xUrl = import.meta.env.PUBLIC_X_URL || 'https://x.com/ramper_dep';
const blueskyUrl = import.meta.env.PUBLIC_BLUESKY_URL || 'https://bsky.app/profile/ramper.bsky.social';
const merchUrl = import.meta.env.PUBLIC_MERCH_URL || 'https://humointernacional.com/tienda/artista-ramper/';

// Navigation items
const navItems = [
  { label: 'música', href: '/music', section: 'music' },
  { label: 'conciertos', href: '/shows', section: 'shows' },
  { label: 'noticias', href: '/news', section: 'news' },
  { label: 'vídeo', href: '/video', section: 'video' },
  { label: 'merch↗', href: merchUrl, section: 'merch', external: true },
];

const secondaryNavItems = [
  { label: '¿...quién?', href: '/about', section: 'about' },
];

const tertiaryNavItems = [
  { label: 'escribe', href: '/contact', section: 'contact' },
];
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <Head
      title={title}
      description={description}
      ogImage={ogImage}
      siteUrl={siteUrl}
      canonicalUrl={canonicalUrl}
    />
    <ClientRouter />
  </head>
  <body class="overflow-hidden">
    {/* Global noise layer */}
    <div class="animated-grain" aria-hidden="true"></div>

    {/* Full-screen wrapper */}
    <div class="relative w-screen h-screen overflow-hidden" id="site-wrapper">

      <TextureBackground />

      <MobileHeader />

      <MobileMenu
        navItems={navItems}
        secondaryNavItems={secondaryNavItems}
        tertiaryNavItems={tertiaryNavItems}
        activeSection={activeSection}
      />

      {/* MAIN LAYOUT: Sidebar + Content */}
      <div class="relative z-10 flex h-full">

        <DesktopSidebar
          navItems={navItems}
          secondaryNavItems={secondaryNavItems}
          tertiaryNavItems={tertiaryNavItems}
          activeSection={activeSection}
          instagramUrl={instagramUrl}
          xUrl={xUrl}
          blueskyUrl={blueskyUrl}
        />

        {/* RIGHT CONTENT AREA */}
        <main class="flex-1 h-full overflow-y-auto pt-[var(--mobile-header-h)] lg:pt-0" id="content-area" transition:animate="fade">
          <slot />

          {/* Mobile social links */}
          <footer class="flex lg:hidden items-center justify-center py-8 border-t border-ramper-black/10 mx-8" id="mobile-social-links">
            <SocialLinks
              instagramUrl={instagramUrl}
              xUrl={xUrl}
              blueskyUrl={blueskyUrl}
              gap="gap-6"
            />
          </footer>
        </main>
      </div>
    </div>
  </body>
</html>
